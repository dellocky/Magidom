[resource]
script = ExtResource("1")
description = "Hurls a massive blast of lightning at a target enemy unit. They are probably dead by the time you've read this."
lore = "He wanted to command the power of the Sun, but when he reached up to the heavens it was the storm that answered."
cooldown = 60.0
